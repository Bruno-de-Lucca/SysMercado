target/

# Logs e arquivos de execução
*.log
*.tmp
*.bak
*.swp

# Arquivos de ambiente de desenvolvimento - IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Arquivos de ambiente de desenvolvimento - Eclipse
.project
.classpath
.settings/
bin/

# Arquivos de ambiente de desenvolvimento - Visual Studio Code
.vscode/

# Arquivos de sistema operacional
.DS_Store
Thumbs.db
desktop.ini
